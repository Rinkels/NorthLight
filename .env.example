# Copy to .env for local development. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use SQLite (db.sqlite3). For PostgreSQL either:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/northlight
# or the DB_* form used on Cloud Run (DB_HOST=/cloudsql/<connection name> for the socket):
# DB_NAME=northlight  DB_USER=northlight  DB_PASSWORD=...  DB_HOST=...  DB_PORT=5432

# Production only
# DJANGO_CSRF_TRUSTED_ORIGINS=https://life.mindsgate.com
# EMAIL_HOST=smtp.gmail.com  EMAIL_HOST_USER=you@example.com  EMAIL_HOST_PASSWORD=app-password
# DEFAULT_FROM_EMAIL=NorthLight <you@example.com>
